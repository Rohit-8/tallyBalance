# Copy to .env and adjust. NEVER commit .env — it is gitignored for a reason.
#
# These are LOCAL DEVELOPMENT credentials for containers bound to 127.0.0.1 only.
# They are not secrets in the production sense, but the discipline of never
# committing them is what makes it impossible to leak a real one later, so the
# rule is applied here even though the values are throwaway.
#
# Passwords must still satisfy SQL Server's complexity policy (upper, lower, digit,
# symbol, 8+ chars) or the container exits during first start with an error that
# reads like an image problem.

MSSQL_SA_PASSWORD=ChangeMe_Dev_2026!
RABBITMQ_USER=tallybalance
RABBITMQ_PASSWORD=ChangeMe_Dev_2026!
MINIO_ROOT_USER=tallybalance
MINIO_ROOT_PASSWORD=ChangeMe_Dev_2026!
